{
  "name": "job-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "ingest": "node scripts/ingest.ts",
    "seed": "node scripts/seed.ts",
    "push:remote": "node --env-file-if-exists=.env.local scripts/push-remote.ts",
    "pull:remote": "node --env-file-if-exists=.env.local scripts/pull-remote.ts",
    "enrich": "node scripts/enrich.ts",
    "linkcheck": "node scripts/linkcheck.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:private:generate": "drizzle-kit generate --config=drizzle-private.config.ts",
    "db:private:migrate": "node --conditions=react-server scripts/private-migrate.ts",
    "test": "vitest run",
    "worker": "node worker/main.ts",
    "test:worker": "node --test worker/*.check.mjs",
    "test:documents": "node --test worker/documents/check.mjs",
    "test:ats": "node --test worker/ats.check.mjs",
    "test:worker:keyring": "node worker/qualify-keyring.mjs",
    "status": "node scripts/status.ts",
    "backfill:locations": "node scripts/backfill-locations.ts",
    "merge:duplicates": "node scripts/merge-duplicates.ts",
    "refresh": "bash scripts/refresh.sh",
    "claim:refresh": "node --env-file-if-exists=.env.local scripts/claim-refresh.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@libsql/client": "^0.17.4",
    "@napi-rs/keyring": "2.1.0",
    "@vercel/blob": "2.8.0",
    "better-auth": "1.7.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fflate": "0.8.2",
    "lucide-react": "1.47.0",
    "next": "15.5.25",
    "nodemailer": "^9.1.1",
    "playwright": "1.62.1",
    "pdf-lib": "1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rss-parser": "^3.13.0",
    "sax": "1.6.1",
    "server-only": "0.0.1",
    "yauzl": "3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sax": "1.2.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28",
      "sharp": "0.35.4"
    }
  }
}
