ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_KEY=
CAREERJET_AFFID=
USAJOBS_KEY=
USAJOBS_EMAIL=

# Hosted deploy only. `npm run push:remote` mirrors the local corpus into this database and
# the app reads it; leave both unset and the app reads ./workie.db instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Talkie's write gate. Reading the board needs nothing; creating, editing and deleting notes
# require this token in an `x-workie-token` header, which the board asks for once and keeps in
# the browser. Note ids are sequential and notes are the one table `push:remote` does NOT
# mirror, so an ungated DELETE loop would destroy the only copy.
#
# A HOSTED deploy with this unset refuses every write (503) rather than serving them to the
# internet. Left unset locally, there is no gate, so `next dev` works unchanged.
WORKIE_WRITE_TOKEN=

# Set to 1 to let THIS machine start a refresh cycle via POST /api/refresh. Off by default:
# the cycle ends by mirroring to the hosted database, deleting rows the GitHub Actions
# lineage wrote, and the POST is a CORS simple request any page could fire at a dev server.
WORKIE_ALLOW_LOCAL_REFRESH=

# Sending, over Gmail SMTP. All three or none — `sendConfigured()` reports unconfigured
# rather than failing at send time, and the UI hides the send button accordingly.
#
# WORKIE_SEND_TOKEN is DELIBERATELY NOT WORKIE_WRITE_TOKEN. That one guards sticky notes;
# this one guards sending mail as you, from your real address, to anyone. Different blast
# radius, so losing one must not grant the other.
#
# The app password is a 16-character code from https://myaccount.google.com/apppasswords
# (needs 2-Step Verification on). It is read only in a server route and never reaches the
# browser. The Gmail API was rejected for this: `gmail.send` is a sensitive scope and a
# consent screen in "Testing" issues refresh tokens that expire every 7 days.
WORKIE_GMAIL_USER=
WORKIE_GMAIL_APP_PASSWORD=
WORKIE_SEND_TOKEN=

