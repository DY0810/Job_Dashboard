JOOBLE_KEY=
MUSE_API_KEY=

# GitHub Actions owns collection and mirroring; Vercel reads this database.
# Local development uses a separate SQLite snapshot. Never mirror that snapshot into production.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Private applicant storage: explicit, separate from workie.db and the corpus Turso host.
# Local example: file:/absolute/private-directory/applicants.db (0600; private parent directory)
# Hosted example: libsql://separate-private-database.example.turso.io
# Apply only with db:private:migrate; the app never creates or migrates its schema.
WORKIE_PRIVATE_DATABASE_URL=
WORKIE_PRIVATE_DATABASE_AUTH_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
WORKIE_APPLICANT_EMAIL_ALLOWLIST=
WORKIE_AUTH_MAIL_FROM=

# Household access replaces the email/password UI when configured. The passcode is 4-12
# digits; use 10 or more, since 4 digits can be guessed within the daily attempt cap over months.
# Keep it Sensitive in Vercel; the two explicit emails keep DY/May owner IDs stable.
WORKIE_HOUSEHOLD_PASSCODE=
WORKIE_HOUSEHOLD_DY_EMAIL=
WORKIE_HOUSEHOLD_MAY_EMAIL=

# Standalone worker: non-secret configuration only; worker/main.ts does not load .env files.
# HTTPS origin with no trailing slash/path. Owner is the authenticated applicant ID,
# not an email or client-controlled server authorization. Use a private 0700 directory
# outside the repository. No database credential is needed by this process.
WORKIE_WORKER_ORIGIN=
WORKIE_WORKER_OWNER=
WORKIE_WORKER_DIRECTORY=
# Local development/tests only: allows http://127.0.0.1:PORT or http://[::1]:PORT.
# Does not allow localhost, other private HTTP hosts, redirects or TLS verification bypass.
WORKIE_WORKER_ALLOW_LOOPBACK=

# Browser draft recovery only: independent 32 random bytes encoded as canonical base64.
# Never reuse BETTER_AUTH_SECRET. Required before profile/policy writes (no generated defaults).
# Authenticated draft-key route releases only an owner-specific HKDF-derived AES-256 key.
# Browser keeps that key in memory; localStorage holds AES-GCM ciphertext/IV/owner/version only.
# Same-principal reauthentication unlocks the same drafts. Principal switch clears plaintext.
# Rotate BOTH values to invalidate all old draft ciphertext; saved server profiles remain intact.
# No old-key fallback: warn users before rotation and discard unrecoverable drafts explicitly.
WORKIE_DRAFT_ENCRYPTION_KEY=
WORKIE_DRAFT_KEY_VERSION=

# Documents: explicit private local directory OR private Vercel Blob; never public storage.
WORKIE_DOCUMENT_STORAGE=
WORKIE_DOCUMENT_DIRECTORY=
WORKIE_DOCUMENT_BLOB_ORIGIN=
WORKIE_DOCUMENT_CALLBACK_URL=
BLOB_READ_WRITE_TOKEN=

# Set to 1 to let THIS machine start a refresh cycle via POST /api/refresh. Off by default:
# the cycle ends by mirroring to the hosted database, deleting rows the GitHub Actions
# lineage wrote, and the POST is a CORS simple request any page could fire at a dev server.
WORKIE_ALLOW_LOCAL_REFRESH=

# Vercel only: fine-grained GitHub token restricted to this repository, Actions read/write.
# Without it the hosted button queues a request for the next (possibly delayed) scheduled run.
WORKIE_GH_TOKEN=
WORKIE_GH_REPO=DY0810/Workie

# Production only: separate bearer secret for GET /api/cron/refresh.
# Store it as Sensitive in Vercel and send it in the scheduler's Authorization header, never its URL.
CRON_SECRET=

# Recruiters tab in the posting drawer: Hunter.io domain search for the company's HR/recruiting
# people (name, title, LinkedIn, email). Optional; without it the tab still shows LinkedIn search
# links. Read only on the server, and only for a signed-in applicant, so the public board cannot
# spend the quota. Free plan: https://hunter.io/api-keys
WORKIE_HUNTER_API_KEY=
